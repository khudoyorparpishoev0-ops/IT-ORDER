# ============================================================================
# HONA ORDER — переменные окружения.
# Скопируйте в .env и заполните. Файл .env в git не попадает.
#
# Значения вписывайте В СУЩЕСТВУЮЩИЕ СТРОКИ. Дописывание блоков в конец
# создаёт повтор ключа, а при повторе docker compose берёт ПОСЛЕДНЕЕ
# значение — пустая строка внизу молча перебивает заполненную выше.
# Проверить файл: ./deploy/check-env.sh
# ============================================================================

# --- Имя проекта Docker ---
# Из него складываются имена контейнеров, образов и сети:
# hona-order-api-1, hona-order-db-1 и так далее. Без этой переменной
# Docker берёт имя папки, и при папке /opt/hona-core контейнеры
# назывались бы hona-core-*.
#
# Меняете имя у уже запущенного проекта — сначала остановите старый
# (`docker compose down`), иначе его контейнеры останутся висеть и
# займут порты 80 и 443. Данные при этом не теряются: база и сертификаты
# лежат в папках хоста, а не в томах Docker.
COMPOSE_PROJECT_NAME=hona-order

# --- Какие файлы compose использовать ---
# Docker Compose читает эту переменную сам, поэтому на сервере достаточно
# писать `docker compose ps` и `docker compose logs caddy` — без длинного
# перечисления -f. Для локальной разработки без HTTPS оставьте только
# docker-compose.yml.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- База данных ---
POSTGRES_DB=hona_core
POSTGRES_USER=hona
# Обязательно задать: длинная случайная строка. Пример генерации:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Папка хоста под кластер PostgreSQL. Создать до первого запуска:
#   mkdir -p data/postgres
DB_DATA_PATH=./data/postgres

# --- Веб ---
# Порт панели на локальном интерфейсе сервера. Наружу он не смотрит:
# снаружи с панелью говорит только Caddy по HTTPS.
WEB_PORT=8080

# Домен панели. Обязателен для продакшн-запуска: под него Caddy выпускает
# сертификат Let's Encrypt. Домен должен указывать A-записью на этот сервер.
APP_DOMAIN=order.ithona.tj

# Адрес для писем Let's Encrypt об истечении сертификата.
ACME_EMAIL=admin@ithona.tj

# Папки хоста под сертификаты Caddy. Их потеря означает повторный выпуск
# сертификата и риск упереться в лимиты Let's Encrypt.
CADDY_DATA_PATH=./data/caddy
CADDY_CONFIG_PATH=./data/caddy-config

# --- Резервные копии ---
BACKUP_PATH=./data/backups
BACKUP_KEEP_DAYS=14

# --- Приложение ---
APP_ENV=production
APP_TIMEZONE=Asia/Dushanbe
LOG_LEVEL=INFO

# --- Безопасность ---
# Секрет подписи сессий. ОБЯЗАТЕЛЕН: без него приложение не стартует
# в production, потому что любой смог бы подписать себе токен админа.
#   openssl rand -hex 32
SECRET_KEY=

# Срок жизни сессии в минутах. По умолчанию рабочий день с запасом.
SESSION_LIFETIME_MINUTES=720

# Отдавать cookie сессии только по HTTPS. Оставьте true в production.
# Для локальной разработки по http поставьте false, иначе браузер
# cookie не сохранит и вход не сработает.
COOKIE_SECURE=true

# --- Корпоративная почта и второй фактор ---
# Домены КОРПОРАТИВНОЙ ПОЧТЫ через запятую — это не домен панели.
# Войти и быть заведённым может только адрес из этого списка: почта здесь
# одновременно логин и подтверждение того, что человек работает в компании.
#
# ВАЖНО: укажите домен, в котором реально заведены ящики сотрудников
# в Zoho. Ошибка здесь закрывает вход всем, включая администратора.
# Если ящики в нескольких доменах — перечислите через запятую.
ALLOWED_EMAIL_DOMAINS=ithona.tj

# Роли, которым двухфакторный вход обязателен: без него они не получат
# сессию. Остальные могут включить его добровольно.
# Пустая строка — никого не принуждаем, all — всех.
REQUIRE_2FA_ROLES=admin,finance

# Название системы в приложении-аутентификаторе.
TOTP_ISSUER=IT-HONA ORDER

# Защита от перебора: столько неудач подряд — и вход блокируется.
# Без этого шестизначный код подбирается за часы.
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# --- Почта (Zoho Mail) ---
# Сервер зависит от РЕГИОНА аккаунта Zoho. Неверный регион даёт ошибку
# аутентификации, хотя логин и пароль правильные:
#   smtp.zoho.com     — США
#   smtp.zoho.eu      — Европа
#   smtp.zoho.in      — Индия
#   smtp.zoho.com.au  — Австралия
#   smtp.zohocloud.ca — Канада
SMTP_HOST=smtp.zoho.com

# ssl — порт 465, starttls — порт 587. Zoho принимает оба.
SMTP_PORT=465
SMTP_SECURITY=ssl

# Логин — полный адрес ящика.
SMTP_USER=order@ithona.tj

# ПАРОЛЬ ПРИЛОЖЕНИЯ из Zoho, а не пароль от аккаунта. Создаётся в
# Zoho: Мой аккаунт → Безопасность → Пароли приложений. Если у аккаунта
# включён второй фактор, обычный пароль SMTP не примет.
SMTP_PASSWORD=

# Адрес отправителя. Должен принадлежать проверенному в Zoho домену,
# иначе письма отклоняются. Пусто — берётся SMTP_USER.
MAIL_FROM=
MAIL_FROM_NAME=IT-HONA ORDER

# Адрес панели снаружи. Без него ссылку восстановления пароля в письме
# некуда вести.
PUBLIC_BASE_URL=https://order.ithona.tj

# Срок жизни ссылки восстановления пароля, минуты.
PASSWORD_RESET_TTL_MINUTES=30

# --- Напоминания и сводка --------------------------------------------------
# Раз в сутки система напоминает тому, у кого заявка стоит без движения, и
# по понедельникам шлёт сводку по бюджету тем, кто видит отчёты. Уходит и
# письмом, и в Telegram — каждому по тому, что у него подключено.
#
# Со скольких суток на одном шаге заявка считается залежавшейся.
STALE_REQUEST_DAYS=3
# Час по местному времени, когда уходят напоминания и сводка.
REMINDER_HOUR=9
# Выключатель на время диагностики: false — фоновые задачи не запускаются.
SCHEDULER_ENABLED=true

# --- Telegram --------------------------------------------------------------
# Бот пишет автору заявки, что с ней происходит, и зовёт того, к кому она
# пришла. Пусто — уведомлений в Telegram нет, всё остальное работает.
#
# Как завести: в Telegram написать @BotFather → /newbot → имя и @имя бота.
# BotFather выдаст токен вида 123456789:AA... — он и есть TELEGRAM_BOT_TOKEN.
# TELEGRAM_BOT_USERNAME — @имя без собачки: из него собирается ссылка
# привязки https://t.me/<имя>?start=<код>.
#
# После запуска зайти в панель под администратором: «Параметры» →
# «Уведомления в Telegram» → «Настроить бота на этот сервер». Кнопка
# сообщает Telegram адрес вебхука; без неё бот не получит ни одного
# сообщения. Адрес зависит от PUBLIC_BASE_URL и SECRET_KEY — сменили их,
# нажмите кнопку ещё раз. Сервер должен быть доступен Telegram по https.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Push-уведомления на телефон ---
# Панель, поставленная на экран телефона, получает уведомления о заявках
# как обычное приложение — и на Android, и на iPhone (iOS 16.4+).
# Нужен один ключ VAPID; сгенерировать:
#   docker compose exec api python -m app.push_setup
# Проверить:  docker compose exec api python -m app.push_setup --check
# Пусто — push выключен, всё остальное работает. Смена ключа обнуляет
# подписки всех телефонов.
VAPID_PRIVATE_KEY=
# Контакт для push-служб Google и Apple: mailto:адрес. Пусто — берётся
# MAIL_FROM.
VAPID_SUBJECT=

# --- Помощник по материалам (Claude) ---
# Проверяет написание материала в форме заявки и предлагает знакомое
# название из каталога. Ключ — console.anthropic.com → API keys.
# Пусто — помощник выключен, форма работает как раньше.
ANTHROPIC_API_KEY=
# Модель; по умолчанию claude-opus-5.
ASSISTANT_MODEL=
# Сколько ждать ответа модели, секунд. Диалог думает дольше проверки
# написания; по умолчанию 90.
ASSISTANT_TIMEOUT_SECONDS=
# Файл с системным промптом помощника. Пусто — встроенные правила
# (backend/app/services/assistant_prompt.py). Файл позволяет менять
# правила на сервере без пересборки образа.
ASSISTANT_PROMPT_FILE=
# Сколько дней хранить журнал обращений к AI. По нему видно, помогает
# помощник или мешает; заявки, их текст, журнал действий и история
# статусов от чистки не зависят вовсе. По умолчанию 180.
AI_INTERACTIONS_RETENTION_DAYS=

# --- Нормативы времени на этапах (часы) ---
# По ним аналитика решает, что заявка задержалась. Пусто — значения по
# умолчанию: согласование покупки 8, закуп 24, согласование суммы 8,
# оплата 24. Черновик у автора нормативом не ограничен.
# Со скольких часов заявка считается стоящей без движения. Отдельно от
# нормативов этапа: заявка может укладываться в норматив закупа и всё
# равно стоять сутки. По умолчанию 24.
STALE_HOURS=
SLA_PENDING_HOURS=
SLA_SOURCING_HOURS=
SLA_PRICED_HOURS=
SLA_APPROVED_HOURS=
# Файл с правилами AI-аналитика для руководителя. Пусто — встроенные.
ANALYTICS_PROMPT_FILE=

# --- Автоматические сводки ORDER Intelligence ---
# Как часто планировщик ищет критичные проблемы, минут. Заявка не
# становится критичной за минуту, а лишний проход — это запросы к базе
# на ровном месте. По умолчанию 20.
INTELLIGENCE_SCAN_MINUTES=
# Как часто повторяется срочный сигнал, пока проблему не устранили,
# часов. Реже — можно, чаще — нет: напоминание, приходящее слишком
# часто, перестаёт быть напоминанием. По умолчанию 12.
CRITICAL_ALERT_REPEAT_HOURS=

# --- Расход на AI ---
# Ожидаемый расход за календарный месяц, доллары. 0 или пусто — бюджет не
# задан и предупреждать не о чем. По достижении порога помощник НЕ
# выключается: замолчавший посреди дня помощник останавливает работу
# людей, а перерасход — это разговор с владельцем, а не аварийная
# остановка.
AI_MONTHLY_BUDGET_USD=
# При какой доле бюджета предупреждать администратора, проценты.
AI_BUDGET_WARNING_PERCENT=
# Файл с ценами моделей (JSON), если прайс Anthropic изменился:
#   {"claude-opus-5": {"input": "5", "output": "25"}}
# Пусто — встроенная таблица. Цены в долларах за миллион токенов.
AI_PRICES_FILE=

# Первый администратор. Создаётся при старте, если в базе нет ни одного
# админа с паролем. После первого входа СМЕНИТЕ ПАРОЛЬ и удалите эти
# три строки из .env.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Администратор
