# ============================================================================
# HONA CORE — переменные окружения.
# Скопируйте в .env и заполните. Файл .env в git не попадает.
# ============================================================================

# --- База данных ---
POSTGRES_DB=hona_core
POSTGRES_USER=hona
# Обязательно задать: длинная случайная строка. Пример генерации:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Папка хоста под кластер PostgreSQL. Создать до первого запуска:
#   mkdir -p data/postgres
DB_DATA_PATH=./data/postgres

# --- Веб ---
# Порт панели на локальном интерфейсе сервера. Наружу он не смотрит:
# снаружи с панелью говорит только Caddy по HTTPS.
WEB_PORT=8080

# Домен панели. Обязателен для продакшн-запуска: под него Caddy выпускает
# сертификат Let's Encrypt. Домен должен указывать A-записью на этот сервер.
APP_DOMAIN=order.ithona.tj

# Адрес для писем Let's Encrypt об истечении сертификата.
ACME_EMAIL=admin@ithona.tj

# Папки хоста под сертификаты Caddy. Их потеря означает повторный выпуск
# сертификата и риск упереться в лимиты Let's Encrypt.
CADDY_DATA_PATH=./data/caddy
CADDY_CONFIG_PATH=./data/caddy-config

# --- Резервные копии ---
BACKUP_PATH=./data/backups
BACKUP_KEEP_DAYS=14

# --- Приложение ---
APP_ENV=production
APP_TIMEZONE=Asia/Dushanbe
LOG_LEVEL=INFO

# Порог автоодобрения в сомони: заявка на сумму не выше проходит без
# участия руководителя. Значение взято из макета, подтвердить у заказчика.
AUTO_APPROVE_THRESHOLD=500.00

# --- Безопасность ---
# Секрет подписи сессий. ОБЯЗАТЕЛЕН: без него приложение не стартует
# в production, потому что любой смог бы подписать себе токен админа.
#   openssl rand -hex 32
SECRET_KEY=

# Срок жизни сессии в минутах. По умолчанию рабочий день с запасом.
SESSION_LIFETIME_MINUTES=720

# Отдавать cookie сессии только по HTTPS. Оставьте true в production.
# Для локальной разработки по http поставьте false, иначе браузер
# cookie не сохранит и вход не сработает.
COOKIE_SECURE=true

# --- Корпоративная почта и второй фактор ---
# Домены КОРПОРАТИВНОЙ ПОЧТЫ через запятую — это не домен панели.
# Войти и быть заведённым может только адрес из этого списка: почта здесь
# одновременно логин и подтверждение того, что человек работает в компании.
#
# ВАЖНО: укажите домен, в котором реально заведены ящики сотрудников
# в Zoho. Ошибка здесь закрывает вход всем, включая администратора.
# Если ящики в нескольких доменах — перечислите через запятую.
ALLOWED_EMAIL_DOMAINS=ithona.tj

# Роли, которым двухфакторный вход обязателен: без него они не получат
# сессию. Остальные могут включить его добровольно.
# Пустая строка — никого не принуждаем, all — всех.
REQUIRE_2FA_ROLES=admin,finance

# Название системы в приложении-аутентификаторе.
TOTP_ISSUER=IT-HONA CORE

# Защита от перебора: столько неудач подряд — и вход блокируется.
# Без этого шестизначный код подбирается за часы.
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# --- Почта (Zoho Mail) ---
# Сервер зависит от РЕГИОНА аккаунта Zoho. Неверный регион даёт ошибку
# аутентификации, хотя логин и пароль правильные:
#   smtp.zoho.com     — США
#   smtp.zoho.eu      — Европа
#   smtp.zoho.in      — Индия
#   smtp.zoho.com.au  — Австралия
#   smtp.zohocloud.ca — Канада
SMTP_HOST=smtp.zoho.com

# ssl — порт 465, starttls — порт 587. Zoho принимает оба.
SMTP_PORT=465
SMTP_SECURITY=ssl

# Логин — полный адрес ящика.
SMTP_USER=order@ithona.tj

# ПАРОЛЬ ПРИЛОЖЕНИЯ из Zoho, а не пароль от аккаунта. Создаётся в
# Zoho: Мой аккаунт → Безопасность → Пароли приложений. Если у аккаунта
# включён второй фактор, обычный пароль SMTP не примет.
SMTP_PASSWORD=

# Адрес отправителя. Должен принадлежать проверенному в Zoho домену,
# иначе письма отклоняются. Пусто — берётся SMTP_USER.
MAIL_FROM=
MAIL_FROM_NAME=IT-HONA CORE

# Адрес панели снаружи. Без него ссылку восстановления пароля в письме
# некуда вести.
PUBLIC_BASE_URL=https://order.ithona.tj

# Срок жизни ссылки восстановления пароля, минуты.
PASSWORD_RESET_TTL_MINUTES=30

# Первый администратор. Создаётся при старте, если в базе нет ни одного
# админа с паролем. После первого входа СМЕНИТЕ ПАРОЛЬ и удалите эти
# три строки из .env.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Администратор
